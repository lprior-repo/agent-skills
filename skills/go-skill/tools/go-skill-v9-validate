    agent_dir = mirror_root.parent.parent / "agent"
    for rel in DISCOVERY_AGENT_FILES:
        p = agent_dir / rel
        if not p.exists():
            findings.append(Finding("E_AGENT_DISCOVERY_MISSING", str(p), "required OpenCode subagent file missing"))


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate Go-skill bead evidence")
    parser.add_argument("--workspace", required=True)
    parser.add_argument("--bead", required=True)
    parser.add_argument("--state", type=int, choices=range(1, 17))
    parser.add_argument("--landing", action="store_true")
    parser.add_argument("--source-checkout")
    parser.add_argument("--skill-root")
    parser.add_argument("--mirror-root")
    parser.add_argument("--format", choices=["text", "json"], default="text")
    args = parser.parse_args()

    workspace = Path(args.workspace).resolve()
    artifact_root = workspace / ".beads" / args.bead
    findings: list[Finding] = []
    state = 16 if args.landing else args.state
    if state is None:
        return 2

    if args.source_checkout:
        source = Path(args.source_checkout).resolve()
        if workspace == source or source in workspace.parents:
            findings.append(Finding("E_WORKSPACE_IS_SOURCE", str(workspace), "isolated workspace equals or is nested under source checkout"))

    skill_root = Path(args.skill_root).resolve() if args.skill_root else None
    mirror_root = Path(args.mirror_root).resolve() if args.mirror_root else None
    check_mirrors(skill_root, mirror_root, findings)
    check_skill_hygiene(skill_root, findings)
    check_opencode_agent_discovery(mirror_root, findings)
    version, state_range = disk_skill_meta(skill_root)

    for sid in range(1, state + 1):
        for rel in STATE_ARTIFACTS.get(sid, []):
            require_file(artifact_root, rel, findings)

    check_provenance(artifact_root, version, state_range, findings)
    invocations = invocation_rows(artifact_root, findings)
    check_review_provenance(artifact_root, invocations, findings)
    check_conflict_markers(artifact_root, findings)
    check_deferred_global(artifact_root, findings)

    for rel in APPROVAL_FILES:
        check_status(artifact_root, rel, findings, allow_pass=rel in {"formal-verification-report.md", "refinement-verification-report.md"})

    check_lane_decisions(artifact_root, state, invocations, findings)
    proof_obligations = check_proof_obligations(artifact_root, findings)
    check_kani_artifacts(artifact_root, proof_obligations, findings)
    check_trusted_base(artifact_root, state, findings)
    check_pending_smoke(artifact_root, findings)
    check_blocked_tooling(artifact_root, state, proof_obligations, findings)
    rros = check_rro(artifact_root, state, findings)
    check_proof_to_rust_completeness(state, proof_obligations, rros, findings)
    formal_waivers = check_waivers(artifact_root, invocations, findings)
    check_ledger(artifact_root, state, formal_waivers, proof_obligations, rros, findings)
    check_alignment(artifact_root, findings)
    check_matrices(artifact_root, findings)

    result = {"bead": args.bead, "state": state, "status": "FAIL" if findings else "PASS", "findings": findings}
    if args.format == "json":
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"STATUS: {result['status']}")
        for f in findings:
            loc = f"{f['path']}:{f.get('line')}" if "line" in f else f["path"]
            print(f"{f['code']} {loc} - {f['message']}")
    return 1 if findings else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except OSError as exc:
        print(json.dumps({"status": "ERROR", "error": str(exc)}), file=sys.stderr)
        raise SystemExit(3)
