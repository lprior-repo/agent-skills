def artifact_path(root: Path, value: Any) -> Path | None:
    if not isinstance(value, str) or not value:
        return None
    p = Path(value)
    if p.is_absolute():
        return p
    if value.startswith(".beads/"):
        return root.parent.parent / p
    candidate = root / p
    if candidate.exists():
        return candidate
    workspace_candidate = root.parent.parent / p
    if workspace_candidate.exists():
        return workspace_candidate
    return candidate


def seed_text(row: dict[str, Any]) -> str:
    values: list[str] = []
    for key in ["requirement_id", "contract_clause", "domain_claim", "model_boundary", "notes"]:
        value = row.get(key)
        if isinstance(value, str):
            values.append(value)
    for key in ["risk_tags", "suggested_layers"]:
        value = row.get(key)
        if isinstance(value, list):
            values.extend(str(v) for v in value)
        elif isinstance(value, str):
            values.append(value)
    return " ".join(values)


def required_verifiers_for_seed(seed: dict[str, Any]) -> set[str]:
    haystack = seed_text(seed)
    required: set[str] = set()
    if seed.get("behavior_affecting") is True:
        required.update(DEFAULT_RUST_VERIFIERS)
    if CONCURRENCY_RE.search(haystack):
        required.add("loom")
    if UNSAFE_RE.search(haystack):
        required.add("miri")
    if FUZZ_RE.search(haystack):
        required.add("cargo-fuzz")
    if not required:
        required.update(DEFAULT_RUST_VERIFIERS)
    return required


def expected_hash_for(hashes: Any, rel: Any, index: int) -> Any:
    if isinstance(hashes, dict):
        return hashes.get(rel)
    if isinstance(hashes, list) and index < len(hashes):
        return hashes[index]
    return None


def check_artifact_hashes(root: Path, row: dict[str, Any], list_field: str, hashes_field: str, row_idx: int, findings: list[Finding]) -> None:
    artifacts = row.get(list_field)
    hashes = row.get(hashes_field)
    if artifacts in (None, ""):
        artifacts = []
    if not isinstance(artifacts, list):
        findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", f"{list_field} must be a list", row_idx))
        return
    if hashes in (None, ""):
        hashes = []
    if not isinstance(hashes, (list, dict)):
        findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", f"{hashes_field} must be a list or object", row_idx))
        return
    for index, rel in enumerate(artifacts):
        p = artifact_path(root, rel)
        expected = expected_hash_for(hashes, rel, index)
        if not p or not p.is_file():
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", f"artifact missing for {list_field}: {rel}", row_idx))
            continue
        if not expected or not hash_matches(expected, sha256(p)):
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", f"artifact hash mismatch for {rel}", row_idx))


def check_invocation_integrity(root: Path, rows: list[dict[str, Any]], findings: list[Finding]) -> None:
    previous_hash: Any = None
    review_skills = set(INDEPENDENT_REVIEW_FILES.values()) | {"proof-plan-reviewer"}
    for idx, row in enumerate(rows, 1):
        expected_entry_hash = canonical_row_hash({k: v for k, v in row.items() if k != "entry_hash"})
        if not hash_matches(row.get("entry_hash"), expected_entry_hash):
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", "entry_hash does not match canonical row hash", idx))
        if row.get("ledger_sequence") != idx:
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", "ledger_sequence is not contiguous", idx))
        if idx == 1:
            if row.get("previous_entry_hash") not in (None, "", "GENESIS", "0" * 64):
                findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", "first previous_entry_hash must be genesis", idx))
        elif row.get("previous_entry_hash") != previous_hash:
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", "previous_entry_hash does not match prior entry", idx))
        previous_hash = row.get("entry_hash")

        transcript = artifact_path(root, row.get("transcript_artifact"))
        if not transcript or not transcript.is_file():
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", "transcript artifact missing", idx))
        elif not hash_matches(row.get("transcript_hash"), sha256(transcript)):
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", "transcript hash mismatch", idx))

        check_artifact_hashes(root, row, "input_artifacts", "input_artifact_hashes", idx, findings)
        check_artifact_hashes(root, row, "output_artifacts", "output_artifact_hashes", idx, findings)
        if row.get("skill") in review_skills and row.get("reviewed_artifacts_existed_before_start") is not True:
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", "agent-invocation-ledger.jsonl", "reviewed artifacts did not pre-exist review start", idx))


def check_review_provenance(root: Path, invocations: list[dict[str, Any]], findings: list[Finding]) -> None:
    inv_by_id = {row.get("invocation_id"): row for row in invocations}
    for rel, expected_skill in INDEPENDENT_REVIEW_FILES.items():
        p = root / rel
        if not p.exists():
            continue
        body = text(p)
        skill = re.search(r"^reviewer_skill:\s*(\S+)", body, re.M)
        inv = re.search(r"^reviewer_invocation_id:\s*(\S+)", body, re.M)
        writer_inv = re.search(r"^writer_invocation_id:\s*(\S+)", body, re.M)
        if not skill or not inv:
            findings.append(Finding("E_REVIEW_PROVENANCE_MISSING", rel, "missing reviewer_skill or reviewer_invocation_id header"))
            continue
        if writer_inv and writer_inv.group(1) == inv.group(1):
            findings.append(Finding("E_REVIEW_SELF_APPROVAL", rel, "writer and reviewer invocation IDs match"))
        if skill.group(1) != expected_skill:
            findings.append(Finding("E_REVIEW_PROVENANCE_MISSING", rel, f"expected reviewer_skill {expected_skill}"))
        row = inv_by_id.get(inv.group(1))
        if not row:
            findings.append(Finding("E_INVOCATION_LEDGER_MISSING", rel, f"no invocation ledger row {inv.group(1)}"))
        elif row.get("skill") != expected_skill or row.get("status") != "completed":
            findings.append(Finding("E_INVOCATION_LEDGER_FORGED", rel, "invocation row skill/status mismatch"))


def check_conflict_markers(root: Path, findings: list[Finding]) -> None:
    if not root.exists():
        return
    suffixes = {".md", ".json", ".jsonl", ".rs", ".tla", ".cfg", ".toml", ".yaml", ".yml"}
    for p in root.rglob("*"):
        if not p.is_file() or p.suffix.lower() not in suffixes:
            continue
        try:
            body = text(p)
        except OSError:
            continue
        if CONFLICT_RE.search(body):
            findings.append(Finding("E_CONFLICT_MARKER", str(p.relative_to(root)), "merge conflict marker in evidence artifact"))


def check_lane_decisions(root: Path, state: int, invocations: list[dict[str, Any]], findings: list[Finding]) -> None:
    seeds = jsonl(root / "proof-seeds.jsonl", findings)
    lanes = jsonl(root / "verifier-lane-decisions.jsonl", findings)
    reviews = jsonl(root / "verifier-lane-review.jsonl", findings)
    obligations = jsonl(root / "proof-obligations.planned.jsonl", findings)
    obligations_by_id = {row.get("id"): row for row in obligations}
    check_fields(seeds, PROOF_SEED_FIELDS, "proof-seed/v1", root / "proof-seeds.jsonl", findings)
    check_fields(lanes, LANE_FIELDS, "verifier-lane-decision/v1", root / "verifier-lane-decisions.jsonl", findings)
    check_fields(reviews, LANE_REVIEW_FIELDS, "verifier-lane-review/v1", root / "verifier-lane-review.jsonl", findings)
    active: set[tuple[Any, Any, Any, Any]] = set()
    lane_ids: set[Any] = set()
    for idx, row in enumerate(lanes, 1):
        lane_ids.add(row.get("id"))
        if "reviewer_disposition" in row:
            findings.append(Finding("E_LANE_SELF_REVIEW", "verifier-lane-decisions.jsonl", "planner-owned lane decision must not contain reviewer_disposition", idx))
        key = (row.get("requirement_id"), row.get("contract_clause"), row.get("proof_seed_id"), row.get("verifier"))
        if key in active:
            findings.append(Finding("E_LANE_DECISION_DUPLICATE", "verifier-lane-decisions.jsonl", f"duplicate active lane {key}", idx))
        active.add(key)
        if row.get("applicability") == "required" and not row.get("required_obligation_ids"):
            findings.append(Finding("E_LANE_DECISION_WEAK", "verifier-lane-decisions.jsonl", "required lane has no obligation IDs", idx))
        if row.get("verifier") not in VALID_VERIFIERS:
            findings.append(Finding("E_LANE_DECISION_WEAK", "verifier-lane-decisions.jsonl", f"unknown verifier {row.get('verifier')}", idx))
        if row.get("applicability") == "required" and isinstance(row.get("required_obligation_ids"), list):
            for obligation_id in row.get("required_obligation_ids", []):
                obligation = obligations_by_id.get(obligation_id)
                if not obligation:
                    findings.append(Finding("E_LANE_OBLIGATION_MISSING", "verifier-lane-decisions.jsonl", f"required obligation {obligation_id} does not exist", idx))
                    continue
                for field in ["requirement_id", "contract_clause", "verifier"]:
                    if obligation.get(field) != row.get(field):
                        findings.append(Finding("E_LANE_OBLIGATION_MISMATCH", "verifier-lane-decisions.jsonl", f"obligation {obligation_id} {field} mismatch", idx))
        if row.get("applicability") == "not_applicable" and not row.get("non_applicability_evidence_refs"):
            findings.append(Finding("E_LANE_DECISION_WEAK", "verifier-lane-decisions.jsonl", "not_applicable needs evidence refs", idx))
        if row.get("applicability") == "blocked_tooling" and state >= 4:
            findings.append(Finding("E_LANE_BLOCKED_TOOLING", "verifier-lane-decisions.jsonl", "blocked_tooling lane blocks advancement", idx))
    reviews_by_lane: dict[Any, dict[str, Any]] = {}
    inv_by_id = {row.get("invocation_id"): row for row in invocations}
    for idx, row in enumerate(reviews, 1):
        lane_id = row.get("lane_decision_id")
        if lane_id in reviews_by_lane:
            findings.append(Finding("E_LANE_REVIEW_DUPLICATE", "verifier-lane-review.jsonl", f"duplicate lane review {lane_id}", idx))
        reviews_by_lane[lane_id] = row
        if lane_id not in lane_ids:
            findings.append(Finding("E_LANE_REVIEW_ORPHAN", "verifier-lane-review.jsonl", f"review references unknown lane {lane_id}", idx))
        disposition = row.get("reviewer_disposition")
        if disposition not in {"accepted", "rejected"}:
            findings.append(Finding("E_LANE_REVIEW_INVALID", "verifier-lane-review.jsonl", f"invalid reviewer disposition {disposition}", idx))
        if row.get("planner_invocation_id") == row.get("reviewer_invocation_id"):
            findings.append(Finding("E_REVIEW_SELF_APPROVAL", "verifier-lane-review.jsonl", "planner and reviewer invocation IDs match", idx))
        inv = inv_by_id.get(row.get("reviewer_invocation_id"))
        if not inv or inv.get("skill") != "proof-plan-reviewer" or inv.get("status") != "completed":
            findings.append(Finding("E_INVOCATION_LEDGER_MISSING", "verifier-lane-review.jsonl", "missing completed proof-plan-reviewer invocation", idx))
    for seed in seeds:
        for verifier in required_verifiers_for_seed(seed):
            key = (seed.get("requirement_id"), seed.get("contract_clause"), seed.get("id"), verifier)
            if key not in active and state >= 4:
                findings.append(Finding("E_LANE_DECISION_MISSING", "verifier-lane-decisions.jsonl", f"missing lane decision {key}"))
    if state >= 4:
        for lane_id in lane_ids:
            review = reviews_by_lane.get(lane_id)
            if not review:
                findings.append(Finding("E_LANE_REVIEW_MISSING", "verifier-lane-review.jsonl", f"missing review for lane {lane_id}"))
            elif review.get("reviewer_disposition") != "accepted":
                findings.append(Finding("E_LANE_REVIEW_REJECTED", "verifier-lane-review.jsonl", f"lane {lane_id} not accepted"))


def check_proof_obligations(root: Path, findings: list[Finding]) -> list[dict[str, Any]]:
    rows = jsonl(root / "proof-obligations.planned.jsonl", findings)
    check_fields(rows, PROOF_FIELDS, "proof-obligation/v1", root / "proof-obligations.planned.jsonl", findings)
    for idx, row in enumerate(rows, 1):
        if any(k in row for k in ("layer", "checker")) or ("claim" in row and "domain_claim" not in row):
            findings.append(Finding("E_SCHEMA_ALIAS_FIELD", "proof-obligations.planned.jsonl", "legacy proof alias field used", idx))
        if row.get("required") is not True:
            findings.append(Finding("E_SCHEMA_MISSING_FIELD", "proof-obligations.planned.jsonl", "required must be true", idx))
        if row.get("behavior_affecting") is True and row.get("verifier") == "waiver":
            findings.append(Finding("E_BEHAVIOR_WAIVER", "proof-obligations.planned.jsonl", "behavior-affecting waiver is invalid", idx))
    return rows


def check_trusted_base(root: Path, state: int, findings: list[Finding]) -> None:
    rows = jsonl(root / "trusted-base-ledger.jsonl", findings)
    check_fields(rows, TRUST_FIELDS, "trusted-base-ledger/v1", root / "trusted-base-ledger.jsonl", findings)
    markers = {r.get("marker") for r in rows}
    for rel in ["proof-evidence.md", "proof-writer-report.md"]:
        p = root / rel
        if p.exists():
            for match in TRUST_RE.finditer(text(p)):
                if match.group(0) not in markers:
                    findings.append(Finding("E_TRUST_UNLEDGERED_MARKER", rel, f"trust marker {match.group(0)} lacks ledger row"))
    for idx, row in enumerate(rows, 1):
        if state >= 12 and row.get("reviewer_disposition") == "pending":
            findings.append(Finding("E_TRUST_PENDING_AT_CLOSURE", "trusted-base-ledger.jsonl", "trusted base pending at closure", idx))


def check_pending_smoke(root: Path, findings: list[Finding]) -> None:
    body = ""
    for rel in ["proof-evidence.md", "proof-writer-report.md", "proof-review.md"]:
        p = root / rel
        if p.exists():
            body += "\n" + text(p)
    if "PENDING_FORMAL_EXECUTION" in body and not re.search(r"\b(smoke|syntax|typecheck|parser|tiny config)\b", body, re.I):
        findings.append(Finding("E_PROOF_SMOKE_MISSING", "proof-evidence.md", "pending formal execution lacks cheap smoke/syntax/typecheck evidence"))


def check_blocked_tooling(root: Path, state: int, obligations: list[dict[str, Any]], findings: list[Finding]) -> None:
    if state < 5:
        return
    for rel in ["proof-evidence.md", "proof-writer-report.md", "proof-review.md"]:
        p = root / rel
        if p.exists() and "BLOCKED_TOOLING" in text(p):
            findings.append(Finding("E_BLOCKED_TOOLING_ADVANCE", rel, "BLOCKED_TOOLING is a blocker, not State 5 exit evidence"))
    for row in obligations:
        refs: list[Any] = []
        for field in ["artifact", "target"]:
            value = row.get(field)
            refs.extend(value if isinstance(value, list) else [value])
        for rel in refs:
            p = artifact_path(root, rel)
            if p and p.is_file() and "BLOCKED_TOOLING" in text(p):
                findings.append(Finding("E_BLOCKED_TOOLING_ADVANCE", str(rel), "proof artifact contains BLOCKED_TOOLING blocker"))


def iter_refs(value: Any) -> list[Any]:
    if isinstance(value, list):
        return value
    if value in (None, ""):
        return []
    return [value]


def check_kani_artifacts(root: Path, obligations: list[dict[str, Any]], findings: list[Finding]) -> None:
    for idx, row in enumerate(obligations, 1):
        if row.get("verifier") != "kani":
            continue
        refs = iter_refs(row.get("artifact")) + iter_refs(row.get("target"))
        saw_artifact = False
        saw_meaningful = False
        saw_cover = False
        for ref in refs:
            p = artifact_path(root, ref)
            if not p or not p.is_file():
                continue
            saw_artifact = True
            body = text(p)
            saw_cover = saw_cover or bool(KANI_COVER_RE.search(body))
            saw_meaningful = saw_meaningful or bool(KANI_MEANINGFUL_RE.search(body))
            if KANI_ASSERT_TRUE_RE.search(body):
                findings.append(Finding("E_KANI_ASSUMPTION_VACUITY", str(ref), "Kani artifact contains assert(true)-style proof theater"))
        if row.get("behavior_affecting") is True and saw_artifact and saw_cover and not saw_meaningful:
            findings.append(Finding("E_KANI_COVER_ONLY", "proof-obligations.planned.jsonl", "behavior-affecting Kani obligation is satisfied only by cover! reachability", idx))


def check_rro(root: Path, state: int, findings: list[Finding]) -> list[dict[str, Any]]:
    rows = jsonl(root / "rust-refinement-obligations.jsonl", findings)
    check_fields(rows, RRO_FIELDS, "rust-refinement-obligation/v1", root / "rust-refinement-obligations.jsonl", findings)
    for idx, row in enumerate(rows, 1):
        srcs = row.get("source_refs", [])
        tests = row.get("behavior_test_refs", [])
        harnesses = row.get("refinement_harness_refs", [])
        if row.get("behavior_affecting") is True and not tests:
            findings.append(Finding("E_PROOF_TO_RUST_MISSING", "rust-refinement-obligations.jsonl", "behavior-affecting row lacks behavior tests", idx))
        if row.get("behavior_affecting") is True and not harnesses:
            findings.append(Finding("E_REFINEMENT_HARNESS_MISSING", "rust-refinement-obligations.jsonl", "behavior-affecting row lacks separate refinement harness refs", idx))
        if isinstance(tests, list):
            for test_ref in tests:
                if not isinstance(test_ref, str) or BEHAVIOR_TEST_FORBIDDEN_RE.search(test_ref):
                    findings.append(Finding("E_BEHAVIOR_TEST_NOT_INDEPENDENT", "rust-refinement-obligations.jsonl", "behavior_test_refs must be independent executable behavior checks, not verifier harness refs", idx))
        if not isinstance(srcs, list) or not srcs or any(not isinstance(s, str) or not SOURCE_REF.match(s) for s in srcs):
            findings.append(Finding("E_SOURCE_REF_SHAPE", "rust-refinement-obligations.jsonl", "source_refs must be concrete path::symbol refs", idx))
        if isinstance(tests, list) and isinstance(harnesses, list) and set(tests).intersection(harnesses):
            findings.append(Finding("E_BRIDGE_REFS_NOT_DISJOINT", "rust-refinement-obligations.jsonl", "behavior tests overlap verifier harnesses", idx))
        if state >= 12 and row.get("behavior_affecting") is True:
            for field in ["evidence_command", "evidence_workdir", "evidence_artifact"]:
                if row.get(field) in (None, "", []):
                    findings.append(Finding("E_COMMAND_EVIDENCE_MISSING", "rust-refinement-obligations.jsonl", f"verified bridge row missing {field}", idx))
            if row.get("mapping_status") != "verified":
                findings.append(Finding("E_MAPPING_PLANNED_AT_CLOSURE", "rust-refinement-obligations.jsonl", "behavior-affecting bridge row not verified at closure", idx))
        if state >= 12 and row.get("mapping_status") == "planned":
            findings.append(Finding("E_MAPPING_PLANNED_AT_CLOSURE", "rust-refinement-obligations.jsonl", "planned bridge row at closure", idx))
    return rows


def check_proof_to_rust_completeness(state: int, obligations: list[dict[str, Any]], rros: list[dict[str, Any]], findings: list[Finding]) -> None:
    if state < 7:
        return
    rros_by_proof: dict[Any, list[dict[str, Any]]] = {}
    for row in rros:
        rros_by_proof.setdefault(row.get("proof_id"), []).append(row)
    for idx, row in enumerate(obligations, 1):
        if row.get("behavior_affecting") is not True:
            continue
        proof_id = row.get("id")
        matches = rros_by_proof.get(proof_id, [])
        if not matches:
            findings.append(Finding("E_PROOF_TO_RUST_MISSING", "rust-refinement-obligations.jsonl", f"behavior-affecting proof obligation {proof_id} lacks Rust source/test/harness bridge", idx))
            continue
        for bridge in matches:
            if bridge.get("requirement_id") != row.get("requirement_id") or bridge.get("contract_clause") != row.get("contract_clause"):
                findings.append(Finding("E_PROOF_TO_RUST_MISMATCH", "rust-refinement-obligations.jsonl", f"bridge for {proof_id} does not preserve requirement/contract identity", idx))
            if bridge.get("behavior_affecting") is not True:
                findings.append(Finding("E_SCOPE_MISCLASSIFIED_BEHAVIOR", "rust-refinement-obligations.jsonl", f"bridge for behavior-affecting proof {proof_id} is not behavior_affecting", idx))
            if bridge.get("verifier") != row.get("verifier"):
                findings.append(Finding("E_PROOF_TO_RUST_MISMATCH", "rust-refinement-obligations.jsonl", f"bridge for {proof_id} verifier does not match proof obligation", idx))


def check_waivers(root: Path, invocations: list[dict[str, Any]], findings: list[Finding]) -> dict[Any, tuple[dict[str, Any], str]]:
    candidates = jsonl(root / "waiver-candidates.jsonl", findings)
    formal = jsonl(root / "formal-waivers.jsonl", findings)
    check_fields(candidates, WAIVER_CANDIDATE_FIELDS, "waiver-candidate/v1", root / "waiver-candidates.jsonl", findings)
    check_fields(formal, FORMAL_WAIVER_FIELDS, "formal-waiver/v1", root / "formal-waivers.jsonl", findings)
    inv_by_id = {row.get("invocation_id"): row for row in invocations}
    candidates_by_id: dict[Any, tuple[dict[str, Any], str]] = {}
    for idx, row in enumerate(candidates, 1):
        candidates_by_id[row.get("id")] = (row, canonical_row_hash(row))
        if row.get("behavior_affecting") is True:
            findings.append(Finding("E_BEHAVIOR_WAIVER", "waiver-candidates.jsonl", "behavior waiver candidate is invalid", idx))
        if row.get("review_status") not in {"pending", "approved", "rejected"}:
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "waiver-candidates.jsonl", "invalid candidate review_status", idx))
        for field in ["reason", "boundary_proof", "compensating_evidence", "owner", "expiry"]:
            if row.get(field) in (None, "", []):
                findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "waiver-candidates.jsonl", f"candidate missing {field}", idx))
        if not expiry_is_future(row.get("expiry")):
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "waiver-candidates.jsonl", "candidate expiry missing, invalid, or expired", idx))
    formal_by_id: dict[Any, tuple[dict[str, Any], str]] = {}
    for idx, row in enumerate(formal, 1):
        formal_hash = canonical_row_hash(row)
        formal_by_id[row.get("id")] = (row, formal_hash)
        candidate, candidate_hash = candidates_by_id.get(row.get("waiver_candidate_id"), ({}, ""))
        if row.get("behavior_affecting") is True or not row.get("waiver_candidate_id") or not row.get("formal_verifier_invocation_id"):
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", "invalid final waiver lifecycle", idx))
        if not candidate:
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", "formal waiver references missing candidate", idx))
            continue
        if candidate.get("review_status") != "approved":
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", "candidate review_status is not approved", idx))
        if not hash_matches(row.get("waiver_candidate_hash"), candidate_hash):
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", "waiver_candidate_hash does not match candidate row", idx))
        for field in ["requirement_id", "contract_clause", "behavior_affecting", "owner", "expiry", "boundary_proof", "compensating_evidence"]:
            if row.get(field) != candidate.get(field):
                findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", f"formal waiver does not match candidate {field}", idx))
        if row.get("status") != "approved":
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", "formal waiver status must be approved", idx))
        if not expiry_is_future(row.get("expiry")):
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", "formal waiver expiry missing, invalid, or expired", idx))
        review_inv = inv_by_id.get(row.get("approved_candidate_review_invocation_id"))
        if not review_inv or review_inv.get("skill") != "proof-plan-reviewer" or review_inv.get("status") != "completed":
            findings.append(Finding("E_INVOCATION_LEDGER_MISSING", "formal-waivers.jsonl", "missing completed candidate review invocation", idx))
        formal_inv = inv_by_id.get(row.get("formal_verifier_invocation_id"))
        if not formal_inv or formal_inv.get("skill") != "formal-verifier" or formal_inv.get("status") != "completed":
            findings.append(Finding("E_INVOCATION_LEDGER_MISSING", "formal-waivers.jsonl", "missing completed formal-verifier invocation", idx))
    return formal_by_id


def check_ledger(root: Path, state: int, formal_waivers: dict[Any, tuple[dict[str, Any], str]], obligations: list[dict[str, Any]], rros: list[dict[str, Any]], findings: list[Finding]) -> None:
    rows = jsonl(root / "verification-ledger.jsonl", findings)
    check_fields(rows, LEDGER_FIELDS, "verification-ledger/v1", root / "verification-ledger.jsonl", findings)
    seen_waiver_results: set[Any] = set()
    rows_by_obligation: dict[Any, list[dict[str, Any]]] = {}
    for idx, row in enumerate(rows, 1):
        rows_by_obligation.setdefault(row.get("obligation_id"), []).append(row)
        result = row.get("result")
        if result not in LEDGER_RESULTS:
            findings.append(Finding("E_LEDGER_RESULT_INVALID", "verification-ledger.jsonl", f"invalid result {result}", idx))
        if result == "PASS":
            for field in ["command", "workdir", "exit_status", "tool_version", "raw_log", "evidence_artifact", "formal_verifier_invocation_id"]:
                if row.get(field) in (None, "", []):
                    findings.append(Finding("E_COMMAND_EVIDENCE_MISSING", "verification-ledger.jsonl", f"PASS row missing {field}", idx))
            evidence = artifact_path(root, row.get("evidence_artifact"))
            if not evidence or not evidence.is_file():
                findings.append(Finding("E_COMMAND_EVIDENCE_MISSING", "verification-ledger.jsonl", "PASS row evidence_artifact is missing", idx))
        if result == "WAIVED":
            if row.get("behavior_affecting") is True:
                findings.append(Finding("E_BEHAVIOR_WAIVER", "verification-ledger.jsonl", "behavior-affecting ledger waiver", idx))
            waiver = formal_waivers.get(row.get("formal_waiver_id"))
            if not waiver:
                findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "verification-ledger.jsonl", "WAIVED row lacks matching formal waiver", idx))
            else:
                formal_row, formal_hash = waiver
                seen_waiver_results.add(formal_row.get("id"))
                if not hash_matches(row.get("formal_waiver_hash"), formal_hash):
                    findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "verification-ledger.jsonl", "formal_waiver_hash does not match formal waiver row", idx))
                if formal_row.get("ledger_result_ref") != row.get("id"):
                    findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "verification-ledger.jsonl", "formal waiver ledger_result_ref does not match WAIVED row", idx))
                if formal_row.get("formal_verifier_invocation_id") != row.get("formal_verifier_invocation_id"):
                    findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "verification-ledger.jsonl", "formal verifier invocation mismatch", idx))
                for field in ["requirement_id", "contract_clause", "behavior_affecting"]:
                    if row.get(field) != formal_row.get(field):
                        findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "verification-ledger.jsonl", f"WAIVED row does not match formal waiver {field}", idx))
        if state >= 12 and row.get("status") != "closed":
            findings.append(Finding("E_FORMAL_PENDING_AT_CLOSURE", "verification-ledger.jsonl", "ledger row not closed", idx))
    for waiver_id, (formal_row, _) in formal_waivers.items():
        if formal_row.get("status") == "approved" and waiver_id not in seen_waiver_results:
            findings.append(Finding("E_WAIVER_LIFECYCLE_INVALID", "formal-waivers.jsonl", f"approved waiver {waiver_id} lacks WAIVED ledger row"))
    if state >= 12:
        for row in obligations:
            if row.get("required") is not True:
                continue
            ledger_rows = rows_by_obligation.get(row.get("id"), [])
            if row.get("behavior_affecting") is True and not any(item.get("result") == "PASS" for item in ledger_rows):
                findings.append(Finding("E_FORMAL_PENDING_AT_CLOSURE", "verification-ledger.jsonl", f"behavior-affecting proof obligation {row.get('id')} lacks PASS ledger evidence"))
            elif not ledger_rows:
                findings.append(Finding("E_FORMAL_PENDING_AT_CLOSURE", "verification-ledger.jsonl", f"required proof obligation {row.get('id')} lacks ledger evidence"))
        for row in rros:
            if row.get("required") is not True:
                continue
            ledger_rows = rows_by_obligation.get(row.get("id"), [])
            if row.get("behavior_affecting") is True and not any(item.get("result") == "PASS" for item in ledger_rows):
                findings.append(Finding("E_FORMAL_PENDING_AT_CLOSURE", "verification-ledger.jsonl", f"behavior-affecting Rust bridge obligation {row.get('id')} lacks PASS ledger evidence"))


