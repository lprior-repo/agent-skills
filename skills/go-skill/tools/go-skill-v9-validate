class Finding(dict):
    def __init__(self, code: str, path: str, message: str, line: int | None = None):
        super().__init__(code=code, severity="BLOCK", path=path, message=message)
        if line is not None:
            self["line"] = line


def text(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="replace")


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def canonical_row_hash(row: dict[str, Any]) -> str:
    payload = json.dumps(row, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def hash_matches(value: Any, expected: str) -> bool:
    if not isinstance(value, str):
        return False
    return value in {expected, f"sha256:{expected}"}


def expiry_is_future(value: Any) -> bool:
    if not isinstance(value, str) or not value.strip():
        return False
    raw = value.strip()
    if raw.lower() in {"none", "never", "permanent"}:
        return False
    try:
        parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except ValueError:
        return False
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed > datetime.now(timezone.utc)


def jsonl(path: Path, findings: list[Finding]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    if not path.exists():
        return rows
    for idx, raw in enumerate(text(path).splitlines(), 1):
        if not raw.strip():
            continue
        try:
            obj = json.loads(raw)
        except json.JSONDecodeError as exc:
            findings.append(Finding("E_JSONL_PARSE", str(path), str(exc), idx))
            continue
        if not isinstance(obj, dict):
            findings.append(Finding("E_JSONL_OBJECT", str(path), "row is not a JSON object", idx))
            continue
        rows.append(obj)
    return rows


def require_file(root: Path, rel: str, findings: list[Finding]) -> None:
    p = root / rel
    if not p.is_file() or p.stat().st_size == 0:
        findings.append(Finding("E_MISSING_ARTIFACT", rel, "required artifact missing or empty"))


def check_fields(rows: list[dict[str, Any]], fields: set[str], version: str | None, path: Path, findings: list[Finding]) -> None:
    for idx, row in enumerate(rows, 1):
        missing = sorted(fields - row.keys())
        if missing:
            findings.append(Finding("E_SCHEMA_MISSING_FIELD", str(path), f"missing {missing}", idx))
        if version and row.get("schema_version") != version:
            findings.append(Finding("E_SCHEMA_VERSION_MISSING", str(path), f"expected schema_version {version}", idx))


def check_mirrors(skill_root: Path | None, mirror_root: Path | None, findings: list[Finding]) -> None:
    if not skill_root or not mirror_root:
        return
    for rel in MIRROR_FILES:
        left, right = skill_root / rel, mirror_root / rel
        if not left.exists() or not right.exists():
            findings.append(Finding("E_MIRROR_MISSING", rel, "mirror file missing"))
            continue
        if sha256(left) != sha256(right):
            findings.append(Finding("E_MIRROR_DRIFT", rel, "sha256 differs between mirrors"))


def disk_skill_meta(skill_root: Path | None) -> tuple[str | None, str | None]:
    if not skill_root:
        return None, None
    body = text(skill_root / "SKILL.md")
    version = re.search(r'"version":"([^"]+)"', body)
    state = re.search(r'"state_sequence".*?"start":1,"end":(\d+)', body)
    return (version.group(1) if version else None, f"1..{state.group(1)}" if state else None)


def check_provenance(root: Path, expected_version: str | None, expected_range: str | None, findings: list[Finding]) -> None:
    p = root / "runtime-skill-provenance.json"
    if not p.exists():
        findings.append(Finding("E_RUNTIME_PROVENANCE_MISSING", str(p), "missing runtime skill provenance"))
        return
    try:
        obj = json.loads(text(p))
    except json.JSONDecodeError as exc:
        findings.append(Finding("E_RUNTIME_PROVENANCE_PARSE", str(p), str(exc)))
        return
    if obj.get("loaded_skill_name") != "go-skill":
        findings.append(Finding("E_RUNTIME_PROVENANCE_NAME", str(p), "loaded_skill_name must be go-skill"))
    if expected_version and obj.get("loaded_skill_version") != expected_version:
        findings.append(Finding("E_RUNTIME_PROVENANCE_VERSION", str(p), f"loaded {obj.get('loaded_skill_version')} != disk {expected_version}"))
    if expected_range and obj.get("observed_state_range") != expected_range:
        findings.append(Finding("E_RUNTIME_PROVENANCE_STATE_RANGE", str(p), f"observed {obj.get('observed_state_range')} != {expected_range}"))


def check_status(root: Path, rel: str, findings: list[Finding], allow_pass: bool = False) -> None:
    p = root / rel
    if not p.exists():
        return
    tokens = STATUS.findall(text(p))
    if not tokens:
        findings.append(Finding("E_REVIEW_STATUS_MISSING", rel, "missing explicit STATUS line"))
        return
    bad = {"REJECTED", "FAIL", "UNVERIFIED"}.intersection(tokens)
    good = {"APPROVED"} | ({"PASS"} if allow_pass else set())
    if bad or not good.intersection(tokens):
        findings.append(Finding("E_STATUS_NOT_APPROVED", rel, f"status tokens={tokens}"))


