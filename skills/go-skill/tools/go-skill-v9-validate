def check_deferred_global(root: Path, findings: list[Finding]) -> None:
    if not root.exists():
        return
    for p in root.rglob("*"):
        if p.is_file() and "DEFERRED_GLOBAL" in text(p):
            findings.append(Finding("E_DEFERRED_GLOBAL_BANNED", str(p.relative_to(root)), "DEFERRED_GLOBAL is not a pass state"))


def check_skill_hygiene(skill_root: Path | None, findings: list[Finding]) -> None:
    if not skill_root:
        return
    parent = skill_root.parent
    for name in ["rust-contract", "proof-planner", "proof-plan-reviewer", "proof-writer", "proof-reviewer", "proof-to-implementation", "formal-verifier", "test-reviewer"]:
        p = parent / name / "SKILL.md"
        if not p.exists():
            findings.append(Finding("E_SKILL_DISCOVERY_MISSING", str(p), "required skill missing"))
            continue
        body = text(p)
        if len(body.splitlines()) > 180 or len(body.encode("utf-8")) > 12 * 1024:
            findings.append(Finding("E_SKILL_BLOATED", str(p), "SKILL.md exceeds compact budget"))
        if body.count("```json") > 1 or body.count("Required fields") > 3:
            findings.append(Finding("E_SCHEMA_REFERENCE_FORK", str(p), "possible inline schema fork; link canonical references instead"))


def check_opencode_agent_discovery(mirror_root: Path | None, findings: list[Finding]) -> None:
    if not mirror_root or ".opencode" not in mirror_root.parts:
